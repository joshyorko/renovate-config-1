{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":semanticCommits"
    ],
    "rebaseWhen": "never",
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/image-versions(\\.[^.]+)?\\.(yaml|yml)$/"
            ],
            "matchStrings": [
                "image:\\s*(?<packageName>\\S+)\\s*tag:\\s*(?<currentValue>\\S+)\\s*digest:\\s*(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": ["Automerge chore dep updates (digest, pin, patch, minor) when CI passes"],
            "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash"
        },
        {
            "description": ["Dead upstream repo — git ls-remote fails and causes Renovate to exit non-zero"],
            "matchPackageNames": ["https://github.com/pcostanza/closer-mop.git"],
            "enabled": false
        },
        {
            "description": ["Group all projectbluefin/actions SHA updates into one atomic PR"],
            "matchManagers": ["github-actions"],
            "matchDepNames": ["/projectbluefin\\/actions/"],
            "groupName": "projectbluefin/actions",
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash",
            "labels": ["chore/deps", "automerge"]
        }
    ]
}
